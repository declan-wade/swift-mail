diff --git b/swift-mail/Info.plist a/swift-mail/Info.plist
new file mode 100644
index 0000000..68df5d9
--- /dev/null
+++ a/swift-mail/Info.plist
@@ -0,0 +1,27 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+	<!-- Sparkle only. Everything else is still generated by Xcode
+	     (GENERATE_INFOPLIST_FILE stays YES) and merged into this file: custom
+	     keys like these are the one thing INFOPLIST_KEY_* build settings can't
+	     carry, since Xcode honours only a fixed allowlist of names. -->
+	<key>SUFeedURL</key>
+	<string>https://raw.githubusercontent.com/declan-wade/swift-mail/main/appcast.xml</string>
+	<!-- Replaced by `generate_keys` output; see docs/UPDATES.md. Until it holds
+	     a real key Sparkle refuses every update, which is the safe direction to
+	     fail in. -->
+	<key>SUPublicEDKey</key>
+	<string></string>
+	<!-- Sandboxed apps install updates through Sparkle's Installer XPC service;
+	     without this the updater can download but never install. -->
+	<key>SUEnableInstallerLauncherService</key>
+	<true/>
+	<!-- The app has com.apple.security.network.client, so Sparkle downloads
+	     in-process and the Downloader XPC service isn't needed. -->
+	<key>SUEnableAutomaticChecks</key>
+	<true/>
+	<key>SUScheduledCheckInterval</key>
+	<integer>86400</integer>
+</dict>
+</plist>
diff --git b/swift-mail/Services/SoftwareUpdate.swift a/swift-mail/Services/SoftwareUpdate.swift
new file mode 100644
index 0000000..e139eeb
--- /dev/null
+++ a/swift-mail/Services/SoftwareUpdate.swift
@@ -0,0 +1,92 @@
+import Combine
+import Sparkle
+import SwiftUI
+
+/// Sparkle, wired for this app.
+///
+/// The updater is started only when the bundle actually carries a public key.
+/// Sparkle refuses to run without one and reports that as an error alert at
+/// launch, which is not what a build made before `generate_keys` has been run
+/// should greet you with — see `docs/UPDATES.md`. Without a key the app simply
+/// has no update feature, and the menu item says so by being disabled.
+@MainActor
+final class SoftwareUpdate: ObservableObject {
+    /// One updater for the process: Sparkle schedules its own checks, and a
+    /// second instance would schedule a second set.
+    static let shared = SoftwareUpdate()
+
+    /// Nil when the bundle has no public key. Everything else reads as "updates
+    /// unavailable" from that one fact.
+    private let controller: SPUStandardUpdaterController?
+
+    /// False while an update check is already running, and whenever there is no
+    /// updater at all.
+    @Published private(set) var canCheckForUpdates = false
+
+    /// Whether this build can update at all — see the note above about keys.
+    var isAvailable: Bool { controller != nil }
+
+    /// Sparkle owns the storage for both of these (its own `UserDefaults`
+    /// keys), so they are read straight back from it rather than mirrored.
+    /// `objectWillChange` on write is what keeps the toggles in step, since
+    /// Sparkle publishes nothing itself.
+    var checksAutomatically: Bool {
+        get { controller?.updater.automaticallyChecksForUpdates ?? false }
+        set {
+            objectWillChange.send()
+            controller?.updater.automaticallyChecksForUpdates = newValue
+        }
+    }
+
+    var downloadsAutomatically: Bool {
+        get { controller?.updater.automaticallyDownloadsUpdates ?? false }
+        set {
+            objectWillChange.send()
+            controller?.updater.automaticallyDownloadsUpdates = newValue
+        }
+    }
+
+    private init() {
+        let key = Bundle.main.object(forInfoDictionaryKey: "SUPublicEDKey") as? String
+
+        guard let key, !key.isEmpty else {
+            controller = nil
+            return
+        }
+
+        let controller = SPUStandardUpdaterController(
+            startingUpdater: true,
+            updaterDelegate: nil,
+            userDriverDelegate: nil
+        )
+
+        self.controller = controller
+        controller.updater.publisher(for: \.canCheckForUpdates).assign(to: &$canCheckForUpdates)
+    }
+
+    /// "1.0 (12)" — the marketing version people talk about, with the build
+    /// number Sparkle actually compares.
+    static var versionDescription: String {
+        let short = Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String ?? "?"
+        let build = Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "?"
+
+        return "\(short) (\(build))"
+    }
+
+    func checkForUpdates() {
+        controller?.checkForUpdates(nil)
+    }
+}
+
+/// The App menu's "Check for Updates…", which macOS apps put directly under
+/// About.
+struct CheckForUpdatesButton: View {
+    @ObservedObject private var update = SoftwareUpdate.shared
+
+    var body: some View {
+        Button("Check for Updates\u{2026}") {
+            update.checkForUpdates()
+        }
+        .disabled(!update.canCheckForUpdates)
+    }
+}
